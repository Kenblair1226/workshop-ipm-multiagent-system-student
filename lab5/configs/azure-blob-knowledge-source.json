{
  "name": "${AZURE_BLOB_KNOWLEDGE_SOURCE_NAME}",
  "kind": "azureBlob",
  "description": "Indexed Azure Blob documents.",
  "encryptionKey": null,
  "azureBlobParameters": {
    "connectionString": "ResourceId=${AZURE_STORAGE_RESOURCE_ID};",
    "containerName": "${AZURE_BLOB_CONTAINER}",
    "folderPath": "${AZURE_BLOB_FOLDER}",
    "isADLSGen2": false,
    "ingestionParameters": {
      "identity": null,
      "disableImageVerbalization": true,
      "chatCompletionModel": {
        "kind": "azureOpenAI",
        "azureOpenAIParameters": {
          "resourceUri": "${AZURE_OPENAI_ENDPOINT}",
          "deploymentId": "${AZURE_AI_MODEL_DEPLOYMENT_NAME}",
          "modelName": "${AZURE_AI_MODEL_NAME}"
        }
      },
      "embeddingModel": {
        "kind": "azureOpenAI",
        "azureOpenAIParameters": {
          "resourceUri": "${AZURE_OPENAI_ENDPOINT}",
          "deploymentId": "${AZURE_AI_EMBEDDING_DEPLOYMENT_NAME}",
          "modelName": "${AZURE_AI_EMBEDDING_MODEL_NAME}"
        }
      },
      "contentExtractionMode": "minimal",
      "ingestionSchedule": null
    }
  }
}
