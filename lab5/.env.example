# Lab 5 cross-cloud grounding configuration.
# Copy to .env and replace every <...> placeholder. Never commit .env.

# Existing Microsoft Foundry project and model deployments.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>/projects/<project-name>
AZURE_OPENAI_ENDPOINT=https://<foundry-account>.services.ai.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=<chat-model-deployment-name>
AZURE_AI_MODEL_NAME=<chat-model-name>
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=<embedding-model-deployment-name>
AZURE_AI_EMBEDDING_MODEL_NAME=text-embedding-3-large

# Existing Azure AI Search and Blob Storage resources.
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_STORAGE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<storage-account>
AZURE_BLOB_CONTAINER=<blob-container-name>
AZURE_BLOB_FOLDER=lab5/azure

# Full ARM resource ID of the Foundry custom OAuth project connection for GCS.
GCS_FOUNDRY_CONNECTION_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>/projects/<project-name>/connections/<gcs-connection-name>

# Public HTTPS endpoint and a random bearer token for the narrow S3 MCP proxy.
S3_MCP_SERVER_URL=https://<s3-mcp-host>/mcp
S3_MCP_API_KEY=<generate-at-least-32-random-characters>

# Optional resource names. Defaults are shown.
# AZURE_BLOB_KNOWLEDGE_SOURCE_NAME=cross-cloud-blob-ks
# GCS_KNOWLEDGE_SOURCE_NAME=cross-cloud-gcs-ks
# S3_KNOWLEDGE_SOURCE_NAME=cross-cloud-s3-ks
# KNOWLEDGE_BASE_NAME=cross-cloud-grounding-kb
# FOUNDRY_KB_CONNECTION_NAME=cross-cloud-kb-mcp
