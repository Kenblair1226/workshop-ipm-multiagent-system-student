# Copy to .env for local development. Never commit .env.
S3_BUCKET=<approved-bucket>
S3_PREFIX=lab5/aws/
AWS_REGION=<aws-region>
S3_MCP_API_KEY=<generate-at-least-32-random-characters>

# Bounds enforced by the proxy.
S3_MAX_KEYS=25
S3_MAX_OBJECT_BYTES=524288
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Local authentication: prefer an AWS IAM Identity Center/SSO profile.
# Run `aws sso login --profile <profile>` before starting the proxy.
# AWS_PROFILE=<profile>
#
# Do not place AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file or image.
# In AWS hosting, use a workload role. The optional ACA template references
# existing Key Vault secrets instead of embedding values in source control.
